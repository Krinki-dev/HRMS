# ╔══════════════════════════════════════════════════════════════════════╗
# ║  SECURITY: THIS FILE CONTAINS ONLY PLACEHOLDER VALUES              ║
# ║  Real secrets MUST be set via environment variables (Railway, etc.) ║
# ║  Copy this file to .env.local and fill in real values.             ║
# ║  NEVER commit a .env file with real credentials to Git.            ║
# ╚══════════════════════════════════════════════════════════════════════╝

# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ─── JWT (must be 32+ chars in production) ────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_32_CHAR_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Encryption (AES-256 requires exactly 32 bytes) ───────────────────────────
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_OR_BASE64_KEY

# ─── Central Database (Supabase or other Postgres) ────────────────────────────
CENTRAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/central_db

# ─── Supabase (optional — only if using Supabase as central DB) ───────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@syntern.in

# ─── MinIO / S3 Storage ───────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=hrms
MINIO_USE_SSL=false

# ─── Razorpay (Phase 1 — add when billing is implemented) ─────────────────────
# RAZORPAY_KEY_ID=REPLACE_WITH_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET
